# Rendered into /etc/nginx/conf.d/default.conf at image build time by
# frontend/Dockerfile, which substitutes ${API_ORIGIN} / ${API_WS_ORIGIN}
# from the same VITE_API_BASE_URL build arg the JS bundle is compiled
# with. That is the point of the template: the CSP has to name exactly
# the origin the bundle calls, and when the two were maintained
# separately (a hardcoded localhost:8080 here, a build arg there) any
# non-localhost deploy silently had every API request blocked by the
# browser — CSP violations don't surface as request errors in the app.
server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Required, not optional: the console routes by URL (react-router —
    # /jobs, /rollouts, /fleet?device=<id>), so a deep link or a reload
    # on any path other than / hits nginx for a file that doesn't exist.
    # Without this fallback those all 404.
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Browser-side hardening (audit P1.5 / missing security headers).
    # HSTS is intentionally not set here: this listener is plain HTTP
    # behind whatever terminates TLS; emit Strict-Transport-Security from
    # that TLS-terminating proxy instead.
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    # connect-src covers REST plus the CLI console WebSocket; frame-src
    # covers the device web-GUI iframe proxy. Both live on the API origin.
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' ${API_ORIGIN} ${API_WS_ORIGIN}; frame-src 'self' ${API_ORIGIN}; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;
}
