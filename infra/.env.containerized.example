# Template for infra/.env.containerized — copy this file, fill in real
# values, and never commit the copy (already gitignored). Loaded by every
# app service in the docker-compose "containerized" profile
# (`docker compose --profile containerized up -d --build`).
#
# ACS_POSTGRES_DSN, ACS_BSS_ADAPTER_URL, and ACS_INTERNAL_API_URL are
# already wired to the in-network container names directly in
# docker-compose.yml — don't set them here, they'd just be overridden.
#
# Full variable reference (every os.Getenv/envOr* call, grouped by
# binary): see ../deployment-testing-onboarding-guide.md §7. This file
# covers the realistic minimum for a first run, matching that guide's §3.

# NOTE: every service now FAILS CLOSED at startup (audit P0.1): a
# missing, too-short, or placeholder secret (like the literal values
# below) is a fatal error, not a warning. Generate real values, e.g.:
#   openssl rand -base64 32
# The only way to run without secrets is ACS_INSECURE_DEV_MODE=true,
# for isolated local development ONLY — never on a reachable network.

# Auth for the CPE-to-ACS CWMP channel (Digest) — password min 16 bytes
ACS_DIGEST_USERNAME=acs-device
ACS_DIGEST_PASSWORD=change-me

# Auth for ACS-to-CPE Connection Requests
ACS_CONNECTION_REQUEST_USERNAME=acs-connreq
ACS_CONNECTION_REQUEST_PASSWORD=change-me

# First operator account for the console/API — password min 12 bytes
ACS_BOOTSTRAP_ADMIN_USERNAME=admin
ACS_BOOTSTRAP_ADMIN_PASSWORD=change-me

# Signs operator JWTs — min 32 bytes, required by cmd/api
ACS_JWT_SIGNING_SECRET=change-me-32-plus-random-bytes

# Bridges cmd/bssadapter's calls into cmd/api — min 32 bytes, must be
# identical on both, deployment-testing-onboarding-guide.md §7
ACS_INTERNAL_SERVICE_TOKEN=change-me

# Encrypts device_credentials.password / device_cli_credentials at rest
# — min 16 bytes, required by cmd/api
ACS_CREDENTIAL_ENCRYPTION_KEY=change-me

# SSRF guard for the device web-GUI proxy and SSH/Telnet console bridge:
# comma-separated CIDRs of your real device networks (e.g. the WireGuard
# overlay plus CPE management subnets). Loopback/link-local/metadata are
# always refused; unset only restricts to those hard classes.
ACS_DEVICE_NET_ALLOWED_CIDRS=10.99.0.0/16

# Auth for inbound /bss/v1 calls on cmd/bssadapter — at least one of
# these is required (OAuth signing secret min 32 bytes preferred;
# legacy shared token min 16 bytes)
ACS_BSS_OAUTH_SIGNING_SECRET=change-me-32-plus-random-bytes
#ACS_BSS_API_TOKEN=
