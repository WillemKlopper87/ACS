{
  "annotations": {
    "list": []
  },
  "description": "Health of the BSS/CRM boundary: /bss/v1 traffic and latency from Prometheus, and order-to-job outcomes plus webhook delivery backlog from Postgres. The adapter exports no domain metrics of its own, so order and webhook state is read from the tables directly.",
  "editable": true,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "id": 1,
      "title": "Orders (24h)",
      "type": "stat",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "acs-postgres-ds"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "acs-postgres-ds"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT count(*) AS \"Orders\"\n  FROM bss_orders\n WHERE created_at > now() - interval '24 hours'",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "text": {
          "valueSize": 42
        }
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "Orders awaiting dispatch",
      "type": "stat",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "acs-postgres-ds"
      },
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 4,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "acs-postgres-ds"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT count(*) AS \"Not yet notified\"\n  FROM bss_orders\n WHERE notified_at IS NULL",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "text": {
          "valueSize": 42
        }
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "description": "An order the adapter accepted but has not yet reported back on. A rising number means the CPE side is not completing."
    },
    {
      "id": 3,
      "title": "Webhook deliveries pending",
      "type": "stat",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "acs-postgres-ds"
      },
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 9,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "acs-postgres-ds"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT count(*) AS \"Pending\"\n  FROM webhook_deliveries\n WHERE status = 'PENDING'",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "text": {
          "valueSize": 42
        }
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 5
              },
              {
                "color": "red",
                "value": 25
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "title": "Oldest pending delivery",
      "type": "stat",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "acs-postgres-ds"
      },
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 14,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "acs-postgres-ds"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COALESCE(EXTRACT(EPOCH FROM now() - min(created_at)), 0) AS \"Age\"\n  FROM webhook_deliveries\n WHERE status = 'PENDING'",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "text": {
          "valueSize": 42
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 300
              },
              {
                "color": "red",
                "value": 3600
              }
            ]
          }
        },
        "overrides": []
      },
      "description": "Backlog age, not count \u2014 one delivery stuck for an hour matters more than fifty a second old."
    },
    {
      "id": 5,
      "title": "Rate-limit rejections / min",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-ds"
      },
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 19,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-ds"
          },
          "editorMode": "code",
          "expr": "sum(rate(acs_rate_limit_rejected_total{service=\"bssadapter\"}[5m])) * 60",
          "legendFormat": "rejections/min",
          "range": true,
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "text": {
          "valueSize": 42
        }
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "description": "The BSS caller is exceeding its per-token budget; it will be seeing 429s."
    },
    {
      "id": 6,
      "title": "Adapter request rate by route",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-ds"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-ds"
          },
          "editorMode": "code",
          "expr": "sum by (route, status) (rate(acs_http_requests_total{service=\"bssadapter\"}[5m])) * 60",
          "legendFormat": "{{route}} {{status}}",
          "range": true,
          "refId": "A"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": true
          },
          "color": {
            "mode": "palette-classic"
          },
          "unit": "short"
        },
        "overrides": []
      },
      "description": "Traffic on /bss/v1 by route and status class."
    },
    {
      "id": 7,
      "title": "Adapter latency (p95 / p50)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-ds"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-ds"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le, route) (rate(acs_http_request_duration_seconds_bucket{service=\"bssadapter\"}[5m])))",
          "legendFormat": "p95 {{route}}",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-ds"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.50, sum by (le, route) (rate(acs_http_request_duration_seconds_bucket{service=\"bssadapter\"}[5m])))",
          "legendFormat": "p50 {{route}}",
          "range": true,
          "refId": "B"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": true
          },
          "color": {
            "mode": "palette-classic"
          },
          "unit": "s"
        },
        "overrides": []
      },
      "description": "The adapter proxies to cmd/api, so latency here includes the ACS round trip."
    },
    {
      "id": 8,
      "title": "Order outcomes",
      "type": "piechart",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "acs-postgres-ds"
      },
      "gridPos": {
        "h": 9,
        "w": 8,
        "x": 0,
        "y": 12
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "acs-postgres-ds"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COALESCE(j.status, 'NO MATCHING JOB') AS \"Outcome\",\n         count(*) AS \"Orders\"\n  FROM bss_orders o\n  LEFT JOIN jobs j ON j.command_key = o.command_key\n WHERE o.created_at > now() - interval '7 days'\n GROUP BY 1\n ORDER BY 2 DESC",
          "refId": "A"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "pieType": "donut",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": true
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "description": "bss_orders has no status of its own \u2014 an order's fate is its job's. 'NO MATCHING JOB' means the order was recorded but never produced a job, which is the interesting failure."
    },
    {
      "id": 9,
      "title": "Orders by action (7 days)",
      "type": "barchart",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "acs-postgres-ds"
      },
      "gridPos": {
        "h": 9,
        "w": 8,
        "x": 8,
        "y": 12
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "acs-postgres-ds"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT action AS \"Action\", count(*) AS \"Orders\"\n  FROM bss_orders\n WHERE created_at > now() - interval '7 days'\n GROUP BY 1\n ORDER BY 2 DESC",
          "refId": "A"
        }
      ],
      "options": {
        "orientation": "horizontal",
        "xTickLabelRotation": 0,
        "legend": {
          "showLegend": false
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "description": "SUSPEND/ACTIVATE are rejected unless ACS_WALLED_GARDEN_PARAMETER is set."
    },
    {
      "id": 10,
      "title": "Webhook delivery status",
      "type": "piechart",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "acs-postgres-ds"
      },
      "gridPos": {
        "h": 9,
        "w": 8,
        "x": 16,
        "y": 12
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "acs-postgres-ds"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT status AS \"Status\", count(*) AS \"Deliveries\"\n  FROM webhook_deliveries\n WHERE created_at > now() - interval '7 days'\n GROUP BY 1\n ORDER BY 2 DESC",
          "refId": "A"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "pieType": "donut",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": true
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 11,
      "title": "Failing webhook deliveries",
      "type": "table",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "acs-postgres-ds"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 21
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "acs-postgres-ds"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT wd.created_at      AS \"Queued\",\n         wd.event_type      AS \"Event\",\n         wd.status          AS \"Status\",\n         wd.attempts        AS \"Attempts\",\n         wd.last_attempt_at AS \"Last attempt\",\n         ws.target_url      AS \"Target\",\n         ws.account_id      AS \"Account\"\n  FROM webhook_deliveries wd\n  LEFT JOIN webhook_subscriptions ws ON ws.id = wd.subscription_id\n WHERE wd.status <> 'DELIVERED'\n ORDER BY wd.created_at ASC\n LIMIT 100",
          "refId": "A"
        }
      ],
      "options": {
        "cellHeight": "sm",
        "footer": {
          "show": false
        },
        "showHeader": true
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "description": "Oldest first \u2014 the head of this table is what is blocking the BSS from hearing about completions."
    },
    {
      "id": 12,
      "title": "Recent orders",
      "type": "table",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "acs-postgres-ds"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 21
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "acs-postgres-ds"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT o.created_at          AS \"Received\",\n         o.external_order_id  AS \"Order\",\n         o.account_id         AS \"Account\",\n         o.action             AS \"Action\",\n         COALESCE(j.status, 'NO JOB') AS \"Job status\",\n         j.fault_code         AS \"Fault\",\n         d.serial_number      AS \"Serial\"\n  FROM bss_orders o\n  LEFT JOIN jobs j    ON j.command_key = o.command_key\n  LEFT JOIN devices d ON d.id = j.device_id\n ORDER BY o.created_at DESC\n LIMIT 100",
          "refId": "A"
        }
      ],
      "options": {
        "cellHeight": "sm",
        "footer": {
          "show": false
        },
        "showHeader": true
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "description": "Order to job to device, joined on command_key \u2014 the identifier the adapter uses for idempotency."
    }
  ],
