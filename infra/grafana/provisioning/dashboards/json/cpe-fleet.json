  "description": "High-level view of the CPE estate: liveness, CWMP session health, job outcomes and the vendor/data-model mix. Rates come from Prometheus; per-model and per-fault breakdowns come from Postgres, where the cardinality belongs.",
  "editable": true,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "id": 1,
      "title": "Devices online",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-ds"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-ds"
          },
          "editorMode": "code",
          "expr": "sum(acs_devices_online{service=\"acs\",online_status=\"ONLINE\"})",
          "legendFormat": "online",
          "range": true,
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "text": {
          "valueSize": 42
        }
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "description": "Gauge exported by cmd/acs. Correct only because each service is now scraped once \u2014 see infra/prometheus.yml."
