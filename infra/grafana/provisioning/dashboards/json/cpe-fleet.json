    {
      "id": 10,
      "title": "Fleet by vendor and model",
      "type": "barchart",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "acs-postgres-ds"
      },
      "gridPos": {
        "h": 9,
        "w": 8,
        "x": 0,
        "y": 20
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "acs-postgres-ds"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT manufacturer || ' ' || product_class AS \"Model\", count(*) AS \"Devices\"\n  FROM devices\n GROUP BY 1\n ORDER BY 2 DESC",
          "refId": "A"
        }
      ],
      "options": {
        "orientation": "horizontal",
        "xTickLabelRotation": 0,
        "legend": {
          "showLegend": false
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "description": "Vendor mix drives which TR-069 quirks matter. Sourced from Postgres: this is per-model cardinality, which does not belong in Prometheus labels."
    },
    {
      "id": 11,
      "title": "Data model root",
      "type": "piechart",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "acs-postgres-ds"
      },
      "gridPos": {
        "h": 9,
        "w": 8,
        "x": 8,
        "y": 20
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "acs-postgres-ds"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT CASE data_model_root\n           WHEN 'DEVICE2' THEN 'TR-181 (Device.)'\n           WHEN 'IGD1'    THEN 'TR-098 (InternetGatewayDevice.)'\n           ELSE 'Undetected'\n         END AS \"Root\",\n         count(*) AS \"Devices\"\n  FROM devices\n GROUP BY 1\n ORDER BY 2 DESC",
          "refId": "A"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "pieType": "donut",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": true
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "description": "TR-098 devices read fine but cannot be written to \u2014 writes hardcode Device.*. Undetected means parameter discovery has not completed."
    },
    {
      "id": 12,
      "title": "Time since last Inform",
      "type": "barchart",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "acs-postgres-ds"
      },
      "gridPos": {
        "h": 9,
        "w": 8,
        "x": 16,
        "y": 20
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "acs-postgres-ds"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT b.bucket AS \"Last Inform\", count(d.id) AS \"Devices\"\n  FROM (VALUES (1,'< 5 min'), (2,'5-60 min'), (3,'1-24 hours'), (4,'over 24 hours'), (5,'never')) AS b(ord, bucket)\n  LEFT JOIN devices d ON b.ord = CASE\n         WHEN d.last_inform_at IS NULL                          THEN 5\n         WHEN d.last_inform_at > now() - interval '5 minutes'    THEN 1\n         WHEN d.last_inform_at > now() - interval '60 minutes'   THEN 2\n         WHEN d.last_inform_at > now() - interval '24 hours'     THEN 3\n         ELSE 4 END\n GROUP BY b.ord, b.bucket\n ORDER BY b.ord",
          "refId": "A"
        }
      ],
      "options": {
        "orientation": "horizontal",
        "xTickLabelRotation": 0,
        "legend": {
          "showLegend": false
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "description": "The distribution behind the ONLINE/OFFLINE/UNREACHABLE counts. A growing right-hand tail is a fleet problem, not a reporting one."
    },
    {
      "id": 13,
      "title": "Recent job faults",
      "type": "table",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "acs-postgres-ds"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 29
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "acs-postgres-ds"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT j.completed_at AS \"When\",\n         j.type        AS \"Job\",\n         j.fault_code  AS \"Fault\",\n         j.fault_string AS \"Detail\",\n         d.serial_number AS \"Serial\",\n         d.manufacturer || ' ' || d.product_class AS \"Model\"\n  FROM jobs j\n  LEFT JOIN devices d ON d.id = j.device_id\n WHERE j.fault_code IS NOT NULL\n ORDER BY j.completed_at DESC NULLS LAST\n LIMIT 100",
          "refId": "A"
        }
      ],
      "options": {
        "cellHeight": "sm",
        "footer": {
          "show": false
        },
        "showHeader": true
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "description": "Fault codes as reported by the CPE. LEASE_EXPIRED_UNSAFE_RETRY means a destructive RPC was not retried on purpose."
    }
  ],
