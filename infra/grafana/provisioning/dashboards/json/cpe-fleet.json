    {
      "id": 6,
      "title": "CWMP responses by status class",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-ds"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-ds"
          },
          "editorMode": "code",
          "expr": "sum by (status) (rate(acs_http_requests_total{service=\"acs\"}[5m])) * 60",
          "legendFormat": "{{status}}",
          "range": true,
          "refId": "A"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": true
          },
          "color": {
            "mode": "palette-classic"
          },
          "unit": "short"
        },
        "overrides": []
      },
      "description": "Sustained 4xx is the fleet-wide CPE credential mismatch signal (alert: CWMPAuthFailures). This series only exists because the gateway's catch-all handler is now wrapped in InstrumentHTTP; before that the alert queried a metric that was never emitted."
    },
