# See Dockerfile.acs for the rationale shared by all three service images
# (static build, distroless runtime, no container image previously
# existed for any of them).
FROM golang:1.26-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/bssadapter ./cmd/bssadapter

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/bssadapter /app/bssadapter
# :8090 — the BSS/CRM-facing surface (build plan §5.1), the most
# internet-adjacent of the three services.
EXPOSE 8090
USER nonroot:nonroot
ENTRYPOINT ["/app/bssadapter"]
