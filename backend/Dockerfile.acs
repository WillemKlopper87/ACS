# Closes the "no container image for them yet" gap flagged in
# deployment-testing-onboarding-guide.md §1 — an alternative to the
# `go run`/systemd deployment path documented in EC2-DEPLOYMENT-GUIDE.md,
# not a replacement for it.
#
# CGO_ENABLED=0 static binary + distroless base: this codebase's only
# non-stdlib runtime dependencies are pure Go (pgx, prometheus client,
# golang.org/x/*), so there's nothing that needs libc, and no shell/package
# manager needs to ship in the runtime image at all.
FROM golang:1.27-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/acs ./cmd/acs

# distroless "static" (not "base"): still ships ca-certificates (needed for
# mTLS CA verification and any outbound TLS) and a non-root "nonroot" user,
# without glibc this statically-linked binary doesn't need.
FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/acs /app/acs
# :7547 CWMP/SOAP (the CPE fleet); :3478/udp STUN (RFC 5389, optional NAT
# detection) — both documented in deployment-testing-onboarding-guide.md §1.
EXPOSE 7547
EXPOSE 3478/udp
USER nonroot:nonroot
ENTRYPOINT ["/app/acs"]
