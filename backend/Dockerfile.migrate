# cmd/migrate as an image: applies the schema migrations and the
# per-service table privileges, then exits. The Compose "containerized"
# profile runs it once, as the schema owner, before the services start,
# so the services themselves can log in with less. Same build and base
# as the service images (see Dockerfile.acs).
# Base images are pinned by digest as well as by tag: a tag can be moved
# to different content, a digest cannot. Dependabot (docker) raises the
# digest when the tag is updated.
FROM golang:1.26-alpine@sha256:30b1e546a9c7fa3b747c2bdba3a0c7bdf3a02ebb4c5b8405d2f948d7e8aac4ec AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/migrate ./cmd/migrate

FROM gcr.io/distroless/static-debian12:nonroot@sha256:afa5c872c891853ca7fcf1f12c3edb23f7eeef36189728842dd51042ff57f7ab
COPY --from=build /out/migrate /app/migrate
USER nonroot:nonroot
ENTRYPOINT ["/app/migrate"]
