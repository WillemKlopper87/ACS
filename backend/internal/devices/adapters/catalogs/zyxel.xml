<?xml version="1.0" encoding="UTF-8"?>
<!--
  Conservative baseline for the Zyxel NR7303-EU01V1F outdoor 5G CPE.
  The device supports TR-069 and TR-369 with a TR-181 Device:2 model.
  This is deliberately limited to standard paths: GetParameterNames
  (CWMP) and GetSupportedDM (USP) remain authoritative for a particular
  firmware image and for any X_ZYXEL_* extensions.
-->
<cwmp:cwmpDataModel vendor="Zyxel" model="NR7303-EU01V1F" specVersion="TR-181 Issue 2">
  <object name="Device." access="readOnly">
    <!-- TR-181 Standard Cellular Interface -->
    <object name="Cellular.Interface.1." access="readOnly">
      <parameter name="Enable" type="boolean" access="readWrite"/>
      <parameter name="Status" type="string" access="readOnly"/>
      <parameter name="IMEI" type="string" access="readOnly"/>
      <parameter name="SupportedAccessTechnologies" type="string" access="readOnly"/>
      
      <object name="USIM.1." access="readOnly">
        <parameter name="MSISDN" type="string" access="readOnly"/>
        <parameter name="IMSI" type="string" access="readOnly"/>
        <parameter name="ICCID" type="string" access="readOnly"/>
      </object>
      
      <!-- TR-181 places radio-level RSRP/RSRQ/RSSI on Interface, not Stats. -->
      <parameter name="RSRP" type="int" access="readOnly"/>
      <parameter name="RSRQ" type="int" access="readOnly"/>
      <parameter name="RSSI" type="int" access="readOnly"/>
    </object>

  </object>
</cwmp:cwmpDataModel>
