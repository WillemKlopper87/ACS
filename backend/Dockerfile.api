# See Dockerfile.acs for the rationale shared by all three service images
# (static build, distroless runtime, no container image previously
# existed for any of them).
FROM golang:1.27-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/api ./cmd/api

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/api /app/api
# :8080 REST API — the console (frontend) and operator tooling.
EXPOSE 8080
USER nonroot:nonroot
ENTRYPOINT ["/app/api"]
