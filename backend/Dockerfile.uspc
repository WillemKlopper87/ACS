# See Dockerfile.acs for the rationale shared by all four service images
# (static build, distroless runtime).
FROM golang:1.26-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/uspc ./cmd/uspc

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/uspc /app/uspc
# :9877 -- WebSocket MTP, :1883 -- MQTT MTP, :8092 -- healthz/readyz/metrics.
EXPOSE 9877 1883 8092
USER nonroot:nonroot
ENTRYPOINT ["/app/uspc"]
